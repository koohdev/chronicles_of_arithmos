{"id":1,"name":"Receptionist Mila","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Mila Char","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["MC Face",0,0,2,"\\N[9]"]},{"code":401,"indent":0,"parameters":["Mila, good to see you again. How are you"]},{"code":401,"indent":0,"parameters":["holding up in this freezing weather?"]},{"code":101,"indent":0,"parameters":["Mila Face",0,0,2,"Receptionist Mila"]},{"code":401,"indent":0,"parameters":["I'm surviving, barely! The guild hall is "]},{"code":401,"indent":0,"parameters":["well-insulated, but I'm still wearing three"]},{"code":401,"indent":0,"parameters":["layers. What can I help you with today?"]},{"code":101,"indent":0,"parameters":["MC Face",0,0,2,"\\N[9]"]},{"code":401,"indent":0,"parameters":["We need information on our next target, Fenrir. "]},{"code":401,"indent":0,"parameters":["Does the guild have a location?"]},{"code":101,"indent":0,"parameters":["Mila Face",0,0,2,"Receptionist Mila"]},{"code":401,"indent":0,"parameters":["Fenrir... right. Our information is incredibly"]},{"code":401,"indent":0,"parameters":["limited, but our scouts report he is somewhere"]},{"code":401,"indent":0,"parameters":["past Frost Town."]},{"code":101,"indent":0,"parameters":["MC Face",0,0,2,"\\N[9]"]},{"code":401,"indent":0,"parameters":["Understood. How do we get to Frost Town?"]},{"code":101,"indent":0,"parameters":["Mila Face",0,0,2,"Receptionist Mila"]},{"code":401,"indent":0,"parameters":["You'll have to travel through the Yeti Forest, "]},{"code":401,"indent":0,"parameters":["which leads directly to Frostbite Pass. But "]},{"code":401,"indent":0,"parameters":["there is a major problem."]},{"code":101,"indent":0,"parameters":["Mila Face",0,0,2,"Receptionist Mila"]},{"code":401,"indent":0,"parameters":["The entrance to the pass has been locked tight"]},{"code":401,"indent":0,"parameters":["for a very long time. Nobody has been able to"]},{"code":401,"indent":0,"parameters":["get through."]},{"code":101,"indent":0,"parameters":["MC Face",0,0,2,"\\N[9]"]},{"code":401,"indent":0,"parameters":["Locked? Does the guild have any clues on how"]},{"code":401,"indent":0,"parameters":["to open it?"]},{"code":101,"indent":0,"parameters":["Mila Face",0,0,2,"Receptionist Mila"]},{"code":401,"indent":0,"parameters":["According to the archives, the gate is sealed"]},{"code":401,"indent":0,"parameters":["with a sigil. It's actually very similar to "]},{"code":401,"indent":0,"parameters":["the Adventurer's mark on your hand."]},{"code":101,"indent":0,"parameters":["Mila Face",0,0,2,"Receptionist Mila"]},{"code":401,"indent":0,"parameters":["It just needs the exact same magical frequency"]},{"code":401,"indent":0,"parameters":["to unlock."]},{"code":101,"indent":0,"parameters":["MC Face",0,0,2,"\\N[9]"]},{"code":401,"indent":0,"parameters":["Any idea where we can find this frequency?"]},{"code":101,"indent":0,"parameters":["Mila Face",0,0,2,"Receptionist Mila"]},{"code":401,"indent":0,"parameters":["Your best bet is an area known as the Crystal"]},{"code":401,"indent":0,"parameters":["Garden. It's a set of ancient ruins that have"]},{"code":401,"indent":0,"parameters":["completely frozen over."]},{"code":101,"indent":0,"parameters":["Mila Face",0,0,2,"Receptionist Mila"]},{"code":401,"indent":0,"parameters":["But I have to warn you... to reach the garden,"]},{"code":401,"indent":0,"parameters":["you'll need to survive the Yeti Forest, cross"]},{"code":401,"indent":0,"parameters":["the Frozen River, and navigate the Glacial"]},{"code":401,"indent":0,"parameters":["Cavern."]},{"code":101,"indent":0,"parameters":["Mila Face",0,0,2,"Receptionist Mila"]},{"code":401,"indent":0,"parameters":["It is an incredibly dangerous trek."]},{"code":101,"indent":0,"parameters":["Elara Sorceress Face",0,0,2,"Elara"]},{"code":401,"indent":0,"parameters":["A frozen river, an icy cavern, and a "]},{"code":401,"indent":0,"parameters":["monster-filled forest just to find a key? "]},{"code":401,"indent":0,"parameters":["Why can't anything be simple?"]},{"code":101,"indent":0,"parameters":["Garrick Swordsman Face",0,0,2,"Garrick"]},{"code":401,"indent":0,"parameters":["Because the Numeromancers aren't fools. They"]},{"code":401,"indent":0,"parameters":["want to make it as difficult as possible to"]},{"code":401,"indent":0,"parameters":["reach their anchors. We knew this wouldn't be"]},{"code":401,"indent":0,"parameters":["easy."]},{"code":101,"indent":0,"parameters":["MC Face",0,0,2,"\\N[9]"]},{"code":401,"indent":0,"parameters":["Garrick's right. But we've taken down two"]},{"code":401,"indent":0,"parameters":["already. We can handle whatever is in the"]},{"code":401,"indent":0,"parameters":["Crystal Garden."]},{"code":101,"indent":0,"parameters":["Mila Face",0,0,2,"Receptionist Mila"]},{"code":401,"indent":0,"parameters":["Speaking of handling things... that actually"]},{"code":401,"indent":0,"parameters":["reminds me of something."]},{"code":101,"indent":0,"parameters":["Mila Face",0,0,2,"Receptionist Mila"]},{"code":401,"indent":0,"parameters":["You two, at the table! Could you step over"]},{"code":401,"indent":0,"parameters":["here for a moment?"]},{"code":205,"indent":0,"parameters":[5,{"list":[{"code":2,"indent":null},{"code":2,"indent":null},{"code":4,"indent":null},{"code":4,"indent":null},{"code":17,"indent":null},{"code":0}],"repeat":false,"skippable":true,"wait":false}]},{"code":505,"indent":0,"parameters":[{"code":2,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":2,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":4,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":4,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":17,